# Path to the Zotero binary (required for `pnpm start`)
# Linux: /opt/zotero/zotero or ~/Zotero_linux-x86_64/zotero
# WSL + Windows Zotero (profile/data must live under /mnt/c/, not the Linux home tree):
# ZOTERO_PLUGIN_ZOTERO_BIN_PATH="/mnt/c/Program Files/Zotero/zotero.exe"
# ZOTERO_PLUGIN_PROFILE_PATH="/mnt/c/Users/YOU/zotero-review-assistant-dev/profile"
# ZOTERO_PLUGIN_DATA_DIR="/mnt/c/Users/YOU/zotero-review-assistant-dev/data"
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero
