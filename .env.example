# Path to the Zotero binary (required for `pnpm start`)
# Linux example: /opt/zotero/zotero or ~/Zotero_linux-x86_64/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero-10.0.7

# Optional: dedicated dev profile (create via `zotero -P`)
# ZOTERO_PLUGIN_PROFILE_PATH=/path/to/profile

# Optional: separate data directory for dev
# ZOTERO_PLUGIN_DATA_DIR=/path/to/data
