{
    "name": "zotero-review-assistant",
    "version": "2.0.8",
    "repository": {
        "type": "git",
        "url": "https://github.com/ethaeral/zotero-review-assistant-latest.git"
    },
    "scripts": {
        "start": "zotero-plugin serve",
        "build": "zotero-plugin build",
        "release": "zotero-plugin release",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o storybook-static",
        "test-storybook": "test-storybook --index-json",
        "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" \"http-server storybook-static -p 6006 -s\" \"wait-on http://127.0.0.1:6006 && test-storybook --ci --index-json\""
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^8.6.19",
        "@storybook/addon-essentials": "^8.6.19",
        "@storybook/react": "8.6.19",
        "@storybook/react-vite": "^8.6.19",
        "@storybook/test-runner": "^0.19.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.6.2",
        "axe-playwright": "^2.2.2",
        "concurrently": "^10.0.6",
        "esbuild-plugin-tailwindcss": "^2.2.0",
        "esbuild-style-plugin": "^1.6.3",
        "http-server": "^14.1.1",
        "playwright": "^1.64.1",
        "postcss": "^8.5.32",
        "storybook": "^8.6.19",
        "tailwindcss": "^4.3.3",
        "vite": "^6.4.5",
        "vitest": "^5.0.5",
        "wait-on": "^9.5.1",
        "zotero-plugin-scaffold": "^0.9.3",
        "zotero-types": "^4.1.3"
    },
    "dependencies": {
        "docxtemplater": "^3.71.1",
        "esbuild-sass-plugin": "^3.7.0",
        "lucide-react": "^1.66.0",
        "pizzip": "^3.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "typescript": "^5.9.3",
        "zotero-plugin-toolkit": "^6.0.0"
    },
    "zotero-react": {
        "entryPoints": [
            "src/index.tsx",
            "src/preferences.tsx",
            "src/styles/styles.css"
        ],
        "plugin": {
            "name": "Zotero Review Assistant",
            "id": "zoteroreviewassistant@alima-webdev.com",
            "namespace": "Zoteroreviewassistant",
            "releasePage": "https://github.com/ethaeral/zotero-review-assistant-latest/releases",
            "updateURL": "https://raw.githubusercontent.com/ethaeral/zotero-review-assistant-latest/main/update.json"
        }
    },
    "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
